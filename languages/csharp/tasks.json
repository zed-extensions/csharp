[
  {
    "label": "dotnet test $ZED_SYMBOL",
    "command": "dotnet",
    "args": ["test", "--filter", "FullyQualifiedName~$ZED_SYMBOL"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["csharp-test", "csharp-test-class"]
  },
  {
    "label": "dotnet test $ZED_SYMBOL (wait for debugger)",
    "command": "dotnet",
    "args": ["test", "--filter", "FullyQualifiedName~$ZED_SYMBOL"],
    "env": { "VSTEST_HOST_DEBUG": "1" },
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["csharp-test", "csharp-test-class"]
  },
  {
    "label": "dotnet run",
    "command": "dotnet",
    "args": ["run"],
    "cwd": "$ZED_DIRNAME",
    "tags": ["csharp-main"]
  }
]
